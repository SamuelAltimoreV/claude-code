# Server
PORT=8787
# Leave empty to use the embedded PostgreSQL (PGlite) stored in ./data/pg.
# Set to a Postgres/Supabase connection string for production.
DATABASE_URL=
# Set to "true" behind HTTPS so session cookies are Secure.
COOKIE_SECURE=false
# Public base URL (used in invite links, unsubscribe links and webhook URLs)
APP_URL=http://localhost:8787
# Set to "false" once your workspace exists to stop anyone else creating one on this server.
ALLOW_SIGNUP=true
# Where the embedded database is stored when DATABASE_URL is empty.
DATA_DIR=data

# --- Optional integrations (features stay disabled until configured) ---
# AI assistant (Anthropic)
ANTHROPIC_API_KEY=
# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
